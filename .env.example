# 目标网站配置
TARGET_URL=https://www.example-football-odds.com

# 请求配置
REQUEST_TIMEOUT=30
REQUEST_DELAY=2
MAX_RETRIES=3

# 数据存储配置
DATA_DIR=./data
EXPORT_FORMAT=csv  # csv, json, excel

# FAE 火山方舟赛后深度复盘（复用 ARK_API_KEY / ARK_MODEL）
FAE_AI_REVIEW_ENABLED=true
FAE_AI_REVIEW_TIMEOUT=180
FAE_AI_REVIEW_MAX_TOKENS=4096
FAE_AI_REVIEW_MAX_RETRIES=0
FAE_AI_REVIEW_THINKING=disabled

# 将历史深度复盘作为下一日全日研判的分层记忆
FAE_REVIEW_MEMORY_DAYS=7
FAE_REVIEW_MEMORY_OBSERVATION_DAYS=3
FAE_REVIEW_MEMORY_MIN_PATTERN_DAYS=2
FAE_REVIEW_MEMORY_MIN_EVIDENCE=10

# 企业微信群机器人（群聊中添加机器人后复制 Webhook；禁止提交真实密钥）
WECOM_WEBHOOK_URL=
WECOM_ENABLED=true
WECOM_PUSH_DAILY_AI=true
WECOM_PUSH_AI_REVIEW=true
WECOM_PUSH_LIVE_ALERTS=true
WECOM_PUSH_PREMATCH_AI=false

# 每场比赛开赛前30分钟运行一次火山全日研判；每5分钟扫描一次。
# 周一至周五22:00后、周六周日23:00后自动停止付费研判。
FAE_DAILY_AI_ENABLED=true
FAE_PREMATCH_AI_LEAD_MINUTES=30
FAE_PREMATCH_AI_CHECK_MINUTES=5
# 如需同时保留每天固定时刻的全日基线研判，再改为 true。
FAE_DAILY_AI_BASELINE_ENABLED=false
FAE_DAILY_AI_HOUR=12
FAE_DAILY_AI_MINUTE=10
