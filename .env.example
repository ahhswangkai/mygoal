# 目标网站配置
TARGET_URL=https://www.example-football-odds.com

# 请求配置
REQUEST_TIMEOUT=30
REQUEST_DELAY=2
MAX_RETRIES=3

# 数据存储配置
DATA_DIR=./data
EXPORT_FORMAT=csv  # csv, json, excel

# FAE 火山方舟赛后深度复盘（复用 ARK_API_KEY / ARK_MODEL）
FAE_AI_REVIEW_ENABLED=true
FAE_AI_REVIEW_TIMEOUT=180
FAE_AI_REVIEW_MAX_TOKENS=4096
FAE_AI_REVIEW_MAX_RETRIES=0
FAE_AI_REVIEW_THINKING=disabled

# 将历史深度复盘作为下一日全日研判的分层记忆
FAE_REVIEW_MEMORY_DAYS=7
FAE_REVIEW_MEMORY_OBSERVATION_DAYS=3
FAE_REVIEW_MEMORY_MIN_PATTERN_DAYS=2
FAE_REVIEW_MEMORY_MIN_EVIDENCE=10
